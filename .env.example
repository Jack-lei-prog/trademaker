# ── 安全密钥（必填！生成: python -c "import secrets; print(secrets.token_hex(32))"）──
SECRET_KEY=your-secret-key-here

# ── JWT 配置 ──
# JWT_EXPIRY_HOURS=168

# ── CORS 白名单（逗号分隔，部署时改为你的域名）──
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# ── 主 LLM API（必填，二选一）──
# DeepSeek（推荐，国内直连）
LLM_API_KEY=sk-your-deepseek-api-key
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# Kimi/Moonshot（备选）
# LLM_API_KEY=sk-your-kimi-api-key
# LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
# LLM_MODEL=kimi-k2.7-code

# ── 备用 LLM API（可选，主API失败自动切换）──
# LLM_BACKUP1_KEY=
# LLM_BACKUP1_URL=
# LLM_BACKUP1_MODEL=

# ── Flask 环境（本地开发=1，部署=0）──
FLASK_DEBUG=0

# ── SMTP 邮件（QQ邮箱，可选）──
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_EMAIL=your_email@qq.com
SMTP_PASSWORD=your_authorization_code
SENDER_NAME=外贸通

# ── SMTP 加密密钥（可选，不设则自动生成存DB）──
# SMTP_ENCRYPTION_KEY=

# ── 可信代理 IP（逗号分隔，用于正确解析 X-Forwarded-For）──
# TRUSTED_PROXIES=127.0.0.1,::1

# ── Kimi 评价模型（可选，不配则只启用启发式评价）──
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.7-code

# ── 限流后端（memory 或 redis，默认 memory）──
# RATE_LIMIT_BACKEND=memory

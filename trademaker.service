[Unit]
Description=TradeMaster Gunicorn Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/trademaker
ExecStart=/var/www/trademaker/venv/bin/gunicorn wsgi:app --bind 127.0.0.1:8000 --workers=2 --timeout=120 --access-logfile /var/log/trademaker/access.log --error-logfile /var/log/trademaker/error.log
Restart=always
RestartSec=5
EnvironmentFile=/var/www/trademaker/.env

[Install]
WantedBy=multi-user.target
